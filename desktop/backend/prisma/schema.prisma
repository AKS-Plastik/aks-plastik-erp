generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String
  phone               String?
  role                String               @default("user")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  department          String?
  employeeId          String?              @unique
  commissionRate      Float?               @default(3.0)
  notifications       Notification[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  employee            Employee?            @relation(fields: [employeeId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id                           String          @id @default(cuid())
  code                         String          @unique
  name                         String
  initials                     String
  contact                      String          @default("—")
  contactRole                  String          @default("—")
  contactName                  String?
  contactPhone                 String?
  contactEmail                 String?
  region                       String?
  address                      String?
  city                         String?
  postalCode                   String?
  country                      String?
  phone                        String?
  email                        String?
  totalOrders                  Int             @default(0)
  activeOrders                 Int             @default(0)
  badge                        String          @default("0 OPEN")
  badgeType                    String          @default("clear")
  flagged                      Boolean         @default(false)
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  latitude                     Float?
  longitude                    Float?
  accountCode                  String?
  accountHolder                String?
  accountType                  String          @default("Customer")
  bankName                     String?
  bolge                        String?
  branchCode                   String?
  cariTip                      String?
  contactNamePurchasing        String?
  contactPersonEmail           String?
  contactPersonEmailPurchasing String?
  contactPersonPhone           String?
  contactPersonPhonePurchasing String?
  contactPosition              String?
  creditLimit                  Float?
  currency                     String          @default("TRY")
  customerCategory             String?
  customerType                 String          @default("Company")
  district                     String?
  eArchiveStatus               Boolean         @default(false)
  eDispatchStatus              Boolean         @default(false)
  eInvoiceStatus               Boolean         @default(false)
  fullName                     String?
  gdprConsent                  Boolean         @default(false)
  iban                         String?
  industry                     String?
  invoiceScenario              String          @default("Basic")
  invoiceType                  String?
  isCustomer                   Boolean         @default(false)
  istatistikGrup               String?
  mersisNo                     String?
  mukellefTipi                 String?
  notes                        String?
  paymentMethod                String?
  paymentTerm                  String?
  paymentTerms                 String?
  salesRepName                 String?
  taxId                        String?
  taxOffice                    String?
  ticaretSicil                 String?
  orders                       Order[]
  reports                      Report[]
  siteVisits                   SiteVisit[]
  siteVisitNotes               SiteVisitNote[]
  tags                         CustomerTag[]   @relation("CustomerToCustomerTag")
}

model CustomerTag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#e2e8f0")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[] @relation("CustomerToCustomerTag")
}

model Report {
  id          String    @id @default(cuid())
  code        String    @unique
  title       String
  description String    @default("")
  priority    String    @default("Low")
  column      String    @default("open")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customerId  String?
  dueDate     DateTime?
  employeeId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  employee    Employee? @relation(fields: [employeeId], references: [id])
}

model SiteVisit {
  id          String          @id @default(cuid())
  code        String          @unique
  title       String
  location    String          @default("")
  date        String
  time        String
  status      String          @default("Scheduled")
  notes       String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  customerId  String?
  employeeId  String?
  isVisit     Boolean         @default(true)
  orders      Order[]
  customer    Customer?       @relation(fields: [customerId], references: [id])
  employee    Employee?       @relation("SiteVisitCreator", fields: [employeeId], references: [id])
  statusNotes SiteVisitNote[]
  assignees   Employee[]      @relation("SiteVisitAssignees")
}

model Product {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  description          String                @default("")
  category             String                @default("General")
  unit                 String                @default("pcs")
  price                Float                 @default(0)
  stock                Float                 @default(0)
  minStock             Float                 @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  currency             String                @default("USD")
  stockNo              String                @default("")
  isActive             Boolean               @default(true)
  employeeTasks        EmployeeTask[]
  employeeTaskGhosts   EmployeeTaskGhost[]
  orderItems           OrderItem[]
  productionTasks      ProductionTask[]
  productionTaskGhosts ProductionTaskGhost[]
  purchaseOrderItems   PurchaseOrderItem[]
}

model Employee {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  initials             String
  department           String                @default("General")
  position             String                @default("")
  phone                String?
  email                String?
  salary               Float                 @default(0)
  status               String                @default("Active")
  hireDate             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  supervisorId         String?
  isManager            Boolean               @default(false)
  photo                String?
  attendances          Attendance[]
  supervisor           Employee?             @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates         Employee[]            @relation("EmployeeSupervisor")
  employeeTasks        EmployeeTask[]
  employeeTaskGhosts   EmployeeTaskGhost[]
  leaveRequests        LeaveRequest[]
  orders               Order[]
  productionTasks      ProductionTask[]
  productionTaskGhosts ProductionTaskGhost[]
  reports              Report[]
  siteVisits           SiteVisit[]           @relation("SiteVisitCreator")
  siteVisitNotes       SiteVisitNote[]
  user                 User?
  assignedVisits       SiteVisit[]           @relation("SiteVisitAssignees")
}

model Order {
  id                 String              @id @default(cuid())
  code               String              @unique
  status             String              @default("Draft")
  totalAmount        Float               @default(0)
  notes              String              @default("")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customerId         String?
  employeeId         String?
  vat                Float               @default(0)
  salesRepId         String?
  externalId         String?             @unique
  orderDate          DateTime?
  paymentMethod      String              @default("")
  shipmentType       String              @default("")
  visitId            String?
  employeeTasks      EmployeeTask[]
  employeeTaskGhosts EmployeeTaskGhost[]
  financeRecords     FinanceRecord[]
  customer           Customer?           @relation(fields: [customerId], references: [id])
  employee           Employee?           @relation(fields: [employeeId], references: [id])
  salesRep           User?               @relation(fields: [salesRepId], references: [id])
  visit              SiteVisit?          @relation(fields: [visitId], references: [id])
  items              OrderItem[]
}

model OrderItem {
  id                   String                @id @default(cuid())
  productName          String
  quantity             Float                 @default(1)
  unitPrice            Float                 @default(0)
  orderId              String
  productId            String?
  currency             String                @default("USD")
  cuttingMachineId     Int?
  cuttingOperatorId    String?
  extrusionMachineId   Int?
  extrusionOperatorId  String?
  inProductionQuantity Float                 @default(0)
  producedQuantity     Float                 @default(0)
  productCode          String?
  status               String                @default("Pending")
  vat                  Float                 @default(0)
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product?              @relation(fields: [productId], references: [id])
  notes                OrderItemNote[]
  productionLogs       ProductionLog[]
  productionTasks      ProductionTask[]
  productionTaskGhosts ProductionTaskGhost[]
}

model OrderItemNote {
  id          String    @id @default(cuid())
  orderItemId String
  note        String
  authorId    String?
  authorName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model UserRole {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model RolePermission {
  id   Int    @id @default(autoincrement())
  role String
  page String

  @@unique([role, page])
}

model ProductionLog {
  id               String          @id @default(cuid())
  orderItemId      String
  productionTaskId String?
  action           String
  details          String
  createdAt        DateTime        @default(now())
  orderItem        OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productionTask   ProductionTask? @relation(fields: [productionTaskId], references: [id])
}

model StatusPermission {
  id     Int    @id @default(autoincrement())
  role   String
  status String

  @@unique([role, status])
}

model Machine {
  id                   Int                         @id @default(autoincrement())
  name                 String
  createdAt            DateTime                    @default(now())
  code                 String                      @unique
  location             String                      @default("")
  manualName           String                      @default("")
  manualPath           String                      @default("")
  manufacturer         String                      @default("")
  manufacturerContact  String                      @default("")
  manufacturerCountry  String                      @default("")
  nextMaintenanceDue   String                      @default("")
  notes                String                      @default("")
  productionYear       Int?
  status               String                      @default("Active")
  type                 String                      @default("General")
  warrantyExpiry       String                      @default("")
  employeeTasks        EmployeeTask[]
  employeeTaskGhosts   EmployeeTaskGhost[]
  maintenanceRecords   MachineMaintenanceRecord[]
  monthlyMaintenance   MachineMonthlyMaintenance[]
  productionTasks      ProductionTask[]
  productionTaskGhosts ProductionTaskGhost[]
}

model ProductionTask {
  id                 String              @id @default(cuid())
  code               String              @unique
  quantity           Int                 @default(0)
  status             String              @default("open")
  date               String              @default("")
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orderItemId        String?
  machineId          Int?
  operatorId         String?
  productId          String?
  invoicedAt         DateTime?
  invoicedById       String?
  invoicedByName     String?
  isInvoiced         Boolean             @default(false)
  deliveryRecords    DeliveryRecord[]
  employeeTasks      EmployeeTask[]
  employeeTaskGhosts EmployeeTaskGhost[]
  logisticsLogs      LogisticsLog[]
  logs               ProductionLog[]
  machine            Machine?            @relation(fields: [machineId], references: [id])
  operator           Employee?           @relation(fields: [operatorId], references: [id])
  orderItem          OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product            Product?            @relation(fields: [productId], references: [id])
}

model MachineMaintenanceRecord {
  id          Int      @id @default(autoincrement())
  machineId   Int
  date        String
  type        String   @default("Preventive")
  description String   @default("")
  technician  String   @default("")
  cost        Float    @default(0)
  currency    String   @default("USD")
  nextDue     String   @default("")
  createdAt   DateTime @default(now())
  expenses    Json?    @default("[]")
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model MachineMonthlyMaintenance {
  id          Int      @id @default(autoincrement())
  machineId   Int
  year        Int
  month       Int
  description String   @default("")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  isDefault   Boolean? @default(false)
  history     Json?    @default("[]")
  completedBy String?  @default("")
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model FinanceRecord {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String
  category    String   @default("General")
  amount      Float    @default(0)
  date        String
  reference   String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderId     String?
  currency    String   @default("USD")
  order       Order?   @relation(fields: [orderId], references: [id])
}

model Attendance {
  id         String   @id @default(cuid())
  date       String
  checkIn    String?
  checkOut   String?
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model LeaveRequest {
  id         String    @id @default(cuid())
  type       String    @default("Annual")
  startDate  String
  endDate    String
  days       Int       @default(1)
  reason     String    @default("")
  status     String    @default("Pending")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employeeId String
  reviewedBy String?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Supplier {
  id             String              @id @default(cuid())
  code           String              @unique
  name           String
  category       String              @default("General")
  contactName    String              @default("")
  contactPhone   String              @default("")
  contactEmail   String              @default("")
  address        String              @default("")
  country        String              @default("")
  currency       String              @default("USD")
  status         String              @default("Active")
  notes          String              @default("")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  purchaseOrders PurchaseOrder[]
  quotations     PurchaseQuotation[]
}

model PurchaseRequest {
  id              String              @id @default(cuid())
  code            String              @unique
  title           String
  description     String              @default("")
  department      String              @default("")
  createdBy       String              @default("")
  requestedBy     String              @default("")
  priority        String              @default("Medium")
  category        String              @default("General")
  estimatedAmount Float               @default(0)
  currency        String              @default("TRY")
  budgetCode      String              @default("")
  supplierId      String              @default("")
  supplierName    String              @default("")
  notes           String              @default("")
  status          String              @default("Request")
  budgetApproved  Boolean             @default(false)
  budgetNotes     String              @default("")
  approvedBy      String              @default("")
  approvedAt      String?
  rejectionReason String              @default("")
  receivedDate    String?
  receivedBy      String              @default("")
  qcResult        String              @default("")
  qcNotes         String              @default("")
  qcDate          String?
  invoiceNo       String              @default("")
  invoiceDate     String?
  invoiceAmount   Float               @default(0)
  invoiceMatched  Boolean             @default(false)
  paymentDueDate  String?
  paymentStatus   String              @default("")
  paymentDate     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  purchaseOrder   PurchaseOrder?
  quotations      PurchaseQuotation[]
}

model PurchaseQuotation {
  id            String          @id @default(cuid())
  supplierName  String          @default("")
  quotationNo   String          @default("")
  quotationDate String          @default("")
  amount        Float           @default(0)
  currency      String          @default("TRY")
  vat           Float           @default(0)
  deliveryDays  Int             @default(0)
  paymentTerms  String          @default("")
  warranty      String          @default("")
  notes         String          @default("")
  selected      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  requestId     String
  supplierId    String?
  request       PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  code         String              @unique
  status       String              @default("Draft")
  currency     String              @default("USD")
  vat          Float               @default(0)
  totalAmount  Float               @default(0)
  notes        String              @default("")
  expectedDate String              @default("")
  receivedDate String              @default("")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  supplierId   String?
  requestId    String?             @unique
  request      PurchaseRequest?    @relation(fields: [requestId], references: [id])
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  productName     String
  quantity        Int           @default(1)
  unitPrice       Float         @default(0)
  currency        String        @default("USD")
  receivedQty     Int           @default(0)
  createdAt       DateTime      @default(now())
  purchaseOrderId String
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model UserStatusPermission {
  id     Int    @id @default(autoincrement())
  userId String
  status String

  @@unique([userId, status])
}

model UserPurchasingStatusPermission {
  id     Int    @id @default(autoincrement())
  userId String
  status String

  @@unique([userId, status])
}

model EmployeePermission {
  id         Int    @id @default(autoincrement())
  employeeId String
  page       String

  @@unique([employeeId, page])
}

model EmployeeStatusPermission {
  id         Int    @id @default(autoincrement())
  employeeId String
  status     String

  @@unique([employeeId, status])
}

model SiteVisitNote {
  id          String    @id @default(cuid())
  visitId     String
  customerId  String?
  fromStatus  String
  toStatus    String
  note        String
  createdById String?
  createdAt   DateTime  @default(now())
  createdBy   Employee? @relation(fields: [createdById], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visit       SiteVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model EmployeeTask {
  id               String             @id @default(cuid())
  title            String
  date             String
  status           String             @default("pending")
  notes            String?
  employeeId       String?
  machineId        Int?
  orderId          String?
  productionTaskId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  productId        String?
  quantity         Int                @default(0)
  employee         Employee?          @relation(fields: [employeeId], references: [id])
  machine          Machine?           @relation(fields: [machineId], references: [id])
  order            Order?             @relation(fields: [orderId], references: [id])
  product          Product?           @relation(fields: [productId], references: [id])
  productionTask   ProductionTask?    @relation(fields: [productionTaskId], references: [id])
  taskNotes        EmployeeTaskNote[]
}

model EmployeeTaskNote {
  id         String       @id @default(cuid())
  taskId     String
  fromStatus String
  toStatus   String
  note       String
  createdAt  DateTime     @default(now())
  task       EmployeeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model EmployeeTaskGhost {
  id               String          @id @default(cuid())
  originalTaskId   String?
  title            String
  date             String
  status           String          @default("open")
  quantity         Int             @default(0)
  employeeId       String?
  machineId        Int?
  orderId          String?
  productionTaskId String?
  productId        String?
  targetDate       String?
  createdAt        DateTime        @default(now())
  employee         Employee?       @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  machine          Machine?        @relation(fields: [machineId], references: [id], onUpdate: NoAction)
  order            Order?          @relation(fields: [orderId], references: [id], onUpdate: NoAction)
  product          Product?        @relation(fields: [productId], references: [id], onUpdate: NoAction)
  productionTask   ProductionTask? @relation(fields: [productionTaskId], references: [id], onUpdate: NoAction)

  @@index([date])
  @@index([employeeId])
  @@index([originalTaskId])
}

model ProductionTaskGhost {
  id             String     @id @default(cuid())
  originalTaskId String?
  code           String
  quantity       Int        @default(0)
  status         String     @default("open")
  date           String
  orderItemId    String?
  productId      String?
  machineId      Int?
  operatorId     String?
  targetDate     String?
  createdAt      DateTime   @default(now())
  machine        Machine?   @relation(fields: [machineId], references: [id], onUpdate: NoAction)
  operator       Employee?  @relation(fields: [operatorId], references: [id], onUpdate: NoAction)
  orderItem      OrderItem? @relation(fields: [orderItemId], references: [id], onUpdate: NoAction)
  product        Product?   @relation(fields: [productId], references: [id], onUpdate: NoAction)

  @@index([date])
  @@index([operatorId])
  @@index([originalTaskId])
}

model DailyProductionSnapshot {
  id                  String   @id @default(cuid())
  date                String   @unique
  totalCompletedTasks Int      @default(0)
  totalQuantity       Float    @default(0)
  metrics             Json
  isLocked            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Vehicle {
  id        String   @id @default(cuid())
  name      String
  brand     String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryRecord {
  id                String         @id @default(cuid())
  productionTaskId  String
  orderItemId       String?
  isOutsource       Boolean        @default(false)
  carrierEmployeeId String?
  carrierName       String         @default("")
  vehicleId         String?
  vehicleInfo       String         @default("")
  photoUrl          String?
  notes             String?
  createdById       String?
  createdByName     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  productionTask    ProductionTask @relation(fields: [productionTaskId], references: [id], onDelete: Cascade)
}

model LogisticsLog {
  id               String         @id @default(cuid())
  productionTaskId String
  action           String
  fromStatus       String?
  toStatus         String?
  isInvoiced       Boolean?
  description      String
  userId           String?
  userName         String?
  createdAt        DateTime       @default(now())
  productionTask   ProductionTask @relation(fields: [productionTaskId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String   @default("info")
  page      String?
  link      String?
  isRead    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Commission {
  id               String    @id @default(cuid())
  orderId          String
  orderCode        String
  userId           String
  userName         String
  customerId       String?
  customerName     String?
  orderTotal       Float     @default(0)
  orderCurrency    String    @default("TRY")
  rate             Float     @default(3)
  amount           Float     @default(0)
  currency         String    @default("TRY")
  status           String    @default("pending")
  isPaid           Boolean   @default(false)
  paidAt           DateTime?
  paidById         String?
  paidByName       String?
  orderCreatedAt   DateTime  @default(now())
  notes            String?   @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  isManualOverride Boolean   @default(false)

  @@index([createdAt])
  @@index([orderCreatedAt])
  @@index([orderId])
  @@index([paidAt])
  @@index([status])
  @@index([userId])
}

model SystemSetting {
  key       String    @id
  value     Json
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
}
