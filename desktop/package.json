{
  "name": "aks-erp-app",
  "version": "1.0.1",
  "description": "AKS CRM Dashboard Desktop Application",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.web.js",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.config.web.js",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish never",
    "build:exe": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.aks.erp",
    "productName": "AKS CRM Dashboard",
    "copyright": "Copyright © 2026 AKS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/main/aks_logo_dark.png",
      "publisherName": "AKS",
      "requestedExecutionLevel": "asInvoker",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "src/main/convertico-plan_s_48_48.ico",
      "uninstallerIcon": "src/main/convertico-plan_s_48_48.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AKS CRM Dashboard",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "src/main/aks_logo_mac.png"
    },
    "dmg": {
      "title": "AKS CRM Dashboard ${version}",
      "icon": "src/main/aks_logo_mac.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "YOUR_REPO_NAME"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "i18next": "^26.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.22.0",
    "serialport": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}